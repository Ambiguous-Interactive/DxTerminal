.dimmed-theme {
    --dxt-accent: rgba(141, 142, 147, 1);
    --dxt-accent-soft: rgba(201, 202, 219, 1);
    --dxt-error: rgba(241, 74, 101, 1);
    --dxt-error-line: rgba(214, 99, 118, 1);
    --dxt-error-text: rgba(202, 157, 157, 1);
    --dxt-hover: rgba(70, 70, 75, 0.7);
    --dxt-ink: rgba(202, 203, 208, 1);
    --dxt-ink-body: rgba(167, 168, 173, 1);
    --dxt-ink-muted: rgba(167, 168, 173, 1);
    --dxt-input: rgba(30, 30, 35, 0.7);
    --dxt-line: rgba(35, 44, 56, 1);
    --dxt-on-accent: rgba(13, 17, 23, 1);
    --dxt-selection: rgba(90, 90, 95, 0.85);
    --dxt-selection-line: rgba(77, 150, 104, 1);
    --dxt-surface: rgba(40, 40, 45, 0.9);
    --dxt-surface-raised: rgba(55, 55, 60, 1);
    --dxt-syn-choice: rgba(194, 245, 216, 1);
    --dxt-syn-number: rgba(108, 182, 255, 1);
    --dxt-syn-string: rgba(250, 192, 98, 1);
    --dxt-warning: rgba(168, 169, 158, 1);

    --terminal-bg: rgba(40, 40, 45, 0.9);
    --button-bg: rgba(55, 55, 60, 1);
    --input-field-bg: rgba(30, 30, 35, 0.7);
    --button-selected-bg: rgba(90, 90, 95, 0.85);
    --button-hover-bg: rgba(70, 70, 75, 0.7);
    --scroll-bg: rgba(40, 40, 45, 0.9);
    --scroll-color: rgba(167, 168, 173, 1);
    --scroll-inverse-bg: rgba(167, 168, 173, 1);
    --scroll-active-bg: rgba(167, 168, 173, 1);
    --button-text: rgba(167, 168, 173, 1);
    --button-selected-text: rgba(202, 203, 208, 1);
    --button-hover-text: rgba(202, 203, 208, 1);
    --input-text-color: rgba(202, 203, 208, 1);
    --text-message: rgba(167, 168, 173, 1);
    --text-warning: rgba(168, 169, 158, 1);
    --text-input-echo: rgba(201, 202, 219, 1);
    --text-shell: rgba(167, 168, 173, 1);
    --text-error: rgba(202, 157, 157, 1);
    --caret-color: rgba(141, 142, 147, 1);
}
