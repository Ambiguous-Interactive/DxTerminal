.eldritch-horror-theme {
    --dxt-accent: rgba(155, 134, 175, 1);
    --dxt-accent-soft: rgba(148, 169, 158, 1);
    --dxt-error: rgba(239, 72, 99, 1);
    --dxt-error-line: rgba(210, 95, 115, 1);
    --dxt-error-text: rgba(255, 127, 142, 1);
    --dxt-hover: rgba(60, 80, 70, 0.7);
    --dxt-ink: rgba(164, 185, 174, 1);
    --dxt-ink-body: rgba(160, 180, 170, 1);
    --dxt-ink-muted: rgba(148, 169, 158, 1);
    --dxt-input: rgba(20, 35, 30, 0.7);
    --dxt-line: rgba(35, 44, 56, 1);
    --dxt-on-accent: rgba(13, 17, 23, 1);
    --dxt-selection: rgba(100, 40, 60, 0.85);
    --dxt-selection-line: rgba(73, 147, 101, 1);
    --dxt-surface: rgba(30, 45, 40, 0.92);
    --dxt-surface-raised: rgba(45, 65, 55, 1);
    --dxt-syn-choice: rgba(194, 245, 216, 1);
    --dxt-syn-number: rgba(108, 182, 255, 1);
    --dxt-syn-string: rgba(250, 192, 98, 1);
    --dxt-warning: rgba(179, 159, 200, 1);

    --terminal-bg: rgba(30, 45, 40, 0.92);
    --button-bg: rgba(45, 65, 55, 1);
    --input-field-bg: rgba(20, 35, 30, 0.7);
    --button-selected-bg: rgba(100, 40, 60, 0.85);
    --button-hover-bg: rgba(60, 80, 70, 0.7);
    --scroll-bg: rgba(30, 45, 40, 0.92);
    --scroll-color: rgba(148, 169, 158, 1);
    --scroll-inverse-bg: rgba(148, 169, 158, 1);
    --scroll-active-bg: rgba(160, 180, 170, 1);
    --button-text: rgba(160, 180, 170, 1);
    --button-selected-text: rgba(164, 185, 174, 1);
    --button-hover-text: rgba(164, 185, 174, 1);
    --input-text-color: rgba(164, 185, 174, 1);
    --text-message: rgba(160, 180, 170, 1);
    --text-warning: rgba(179, 159, 200, 1);
    --text-input-echo: rgba(148, 169, 158, 1);
    --text-shell: rgba(148, 169, 158, 1);
    --text-error: rgba(255, 127, 142, 1);
    --caret-color: rgba(155, 134, 175, 1);
}
