/* Widget variables keep these themes compatible with the current pack editor. */

.dx-dark-theme {
    --dxt-surface: rgba(13, 17, 23, 0.94);
    --dxt-surface-raised: rgba(22, 28, 37, 1);
    --dxt-hover: rgba(29, 37, 48, 1);
    --dxt-input: rgba(10, 14, 19, 1);
    --dxt-line: rgba(35, 44, 56, 1);
    --dxt-ink: rgba(230, 237, 243, 1);
    --dxt-ink-body: rgba(201, 210, 220, 1);
    --dxt-ink-muted: rgba(154, 163, 175, 1);
    --dxt-accent: rgba(92, 214, 143, 1);
    --dxt-accent-soft: rgba(184, 242, 207, 1);
    --dxt-on-accent: rgba(13, 17, 23, 1);
    --dxt-selection: rgba(18, 48, 31, 1);
    --dxt-selection-line: rgba(52, 126, 82, 1);
    --dxt-warning: rgba(244, 168, 54, 1);
    --dxt-error: rgba(236, 70, 97, 1);
    --dxt-error-line: rgba(180, 68, 90, 1);
    --dxt-error-text: rgba(255, 122, 142, 1);
    --dxt-syn-number: rgba(108, 182, 255, 1);
    --dxt-syn-string: rgba(250, 192, 98, 1);
    --dxt-syn-choice: rgba(194, 245, 216, 1);

    --terminal-bg: rgba(13, 17, 23, 0.94);
    --button-bg: rgba(22, 28, 37, 1);
    --input-field-bg: rgba(10, 14, 19, 1);
    --button-selected-bg: rgba(18, 48, 31, 1);
    --button-hover-bg: rgba(29, 37, 48, 1);
    --scroll-bg: rgba(13, 17, 23, 0.94);
    --scroll-inverse-bg: rgba(154, 163, 175, 1);
    --scroll-active-bg: rgba(201, 210, 220, 1);

    --button-text: rgba(201, 210, 220, 1);
    --button-selected-text: rgba(230, 237, 243, 1);
    --button-hover-text: rgba(230, 237, 243, 1);
    --input-text-color: rgba(230, 237, 243, 1);
    --text-message: rgba(201, 210, 220, 1);
    --text-warning: rgba(244, 168, 54, 1);
    --text-input-echo: rgba(184, 242, 207, 1);
    --text-shell: rgba(154, 163, 175, 1);
    --text-error: rgba(255, 122, 142, 1);

    --scroll-color: rgba(154, 163, 175, 1);
    --caret-color: rgba(92, 214, 143, 1);
}

.dx-paper-theme {
    --dxt-surface: rgba(244, 241, 234, 0.97);
    --dxt-surface-raised: rgba(250, 248, 243, 1);
    --dxt-hover: rgba(239, 235, 225, 1);
    --dxt-input: rgba(255, 255, 255, 1);
    --dxt-line: rgba(228, 223, 209, 1);
    --dxt-ink: rgba(27, 24, 19, 1);
    --dxt-ink-body: rgba(70, 66, 58, 1);
    --dxt-ink-muted: rgba(95, 90, 79, 1);
    --dxt-accent: rgba(31, 122, 71, 1);
    --dxt-accent-soft: rgba(35, 112, 74, 1);
    --dxt-on-accent: rgba(255, 255, 255, 1);
    --dxt-selection: rgba(220, 239, 227, 1);
    --dxt-selection-line: rgba(79, 144, 104, 1);
    --dxt-warning: rgba(154, 91, 0, 1);
    --dxt-error: rgba(196, 40, 71, 1);
    --dxt-error-line: rgba(196, 103, 122, 1);
    --dxt-error-text: rgba(196, 40, 71, 1);
    --dxt-syn-number: rgba(31, 95, 168, 1);
    --dxt-syn-string: rgba(122, 90, 0, 1);
    --dxt-syn-choice: rgba(27, 24, 19, 1);

    --terminal-bg: rgba(244, 241, 234, 0.97);
    --button-bg: rgba(250, 248, 243, 1);
    --input-field-bg: rgba(255, 255, 255, 1);
    --button-selected-bg: rgba(220, 239, 227, 1);
    --button-hover-bg: rgba(239, 235, 225, 1);
    --scroll-bg: rgba(244, 241, 234, 0.97);
    --scroll-inverse-bg: rgba(95, 90, 79, 1);
    --scroll-active-bg: rgba(70, 66, 58, 1);

    --button-text: rgba(70, 66, 58, 1);
    --button-selected-text: rgba(27, 24, 19, 1);
    --button-hover-text: rgba(27, 24, 19, 1);
    --input-text-color: rgba(27, 24, 19, 1);
    --text-message: rgba(70, 66, 58, 1);
    --text-warning: rgba(154, 91, 0, 1);
    --text-input-echo: rgba(35, 112, 74, 1);
    --text-shell: rgba(95, 90, 79, 1);
    --text-error: rgba(196, 40, 71, 1);

    --scroll-color: rgba(95, 90, 79, 1);
    --caret-color: rgba(31, 122, 71, 1);
}

.phosphor-theme {
    --dxt-surface: rgba(7, 17, 11, 0.96);
    --dxt-surface-raised: rgba(12, 26, 17, 1);
    --dxt-hover: rgba(18, 37, 26, 1);
    --dxt-input: rgba(5, 12, 8, 1);
    --dxt-line: rgba(26, 51, 36, 1);
    --dxt-ink: rgba(200, 247, 217, 1);
    --dxt-ink-body: rgba(143, 227, 176, 1);
    --dxt-ink-muted: rgba(95, 179, 131, 1);
    --dxt-accent: rgba(92, 214, 143, 1);
    --dxt-accent-soft: rgba(184, 242, 207, 1);
    --dxt-on-accent: rgba(7, 17, 11, 1);
    --dxt-selection: rgba(20, 61, 38, 1);
    --dxt-selection-line: rgba(47, 122, 79, 1);
    --dxt-warning: rgba(244, 176, 74, 1);
    --dxt-error: rgba(255, 92, 116, 1);
    --dxt-error-line: rgba(180, 68, 90, 1);
    --dxt-error-text: rgba(255, 122, 142, 1);
    --dxt-syn-number: rgba(143, 227, 176, 1);
    --dxt-syn-string: rgba(143, 227, 176, 1);
    --dxt-syn-choice: rgba(200, 247, 217, 1);

    --terminal-bg: rgba(7, 17, 11, 0.96);
    --button-bg: rgba(12, 26, 17, 1);
    --input-field-bg: rgba(5, 12, 8, 1);
    --button-selected-bg: rgba(20, 61, 38, 1);
    --button-hover-bg: rgba(18, 37, 26, 1);
    --scroll-bg: rgba(7, 17, 11, 0.96);
    --scroll-inverse-bg: rgba(95, 179, 131, 1);
    --scroll-active-bg: rgba(143, 227, 176, 1);

    --button-text: rgba(143, 227, 176, 1);
    --button-selected-text: rgba(200, 247, 217, 1);
    --button-hover-text: rgba(200, 247, 217, 1);
    --input-text-color: rgba(200, 247, 217, 1);
    --text-message: rgba(143, 227, 176, 1);
    --text-warning: rgba(244, 176, 74, 1);
    --text-input-echo: rgba(184, 242, 207, 1);
    --text-shell: rgba(95, 179, 131, 1);
    --text-error: rgba(255, 122, 142, 1);

    --scroll-color: rgba(95, 179, 131, 1);
    --caret-color: rgba(92, 214, 143, 1);
}

/* Text roles reach 7:1 and outlines 4.5:1 over black, mid gray and white backdrops. */
.dx-high-contrast-theme {
    --dxt-surface: rgba(0, 0, 0, 0.98);
    --dxt-surface-raised: rgba(14, 18, 26, 1);
    --dxt-hover: rgba(24, 32, 44, 1);
    --dxt-input: rgba(0, 0, 0, 1);
    --dxt-line: rgba(130, 148, 170, 1);
    --dxt-ink: rgba(255, 255, 255, 1);
    --dxt-ink-body: rgba(236, 242, 248, 1);
    --dxt-ink-muted: rgba(176, 188, 202, 1);
    --dxt-accent: rgba(98, 242, 160, 1);
    --dxt-accent-soft: rgba(204, 255, 224, 1);
    --dxt-on-accent: rgba(0, 0, 0, 1);
    --dxt-selection: rgba(10, 52, 32, 1);
    --dxt-selection-line: rgba(82, 214, 138, 1);
    --dxt-warning: rgba(255, 198, 72, 1);
    --dxt-error: rgba(255, 112, 136, 1);
    --dxt-error-line: rgba(255, 128, 148, 1);
    --dxt-error-text: rgba(255, 148, 164, 1);
    --dxt-syn-number: rgba(118, 200, 255, 1);
    --dxt-syn-string: rgba(255, 214, 92, 1);
    --dxt-syn-choice: rgba(212, 255, 232, 1);

    --terminal-bg: rgba(0, 0, 0, 0.98);
    --button-bg: rgba(14, 18, 26, 1);
    --input-field-bg: rgba(0, 0, 0, 1);
    --button-selected-bg: rgba(10, 52, 32, 1);
    --button-hover-bg: rgba(24, 32, 44, 1);
    --scroll-bg: rgba(0, 0, 0, 0.98);
    --scroll-inverse-bg: rgba(176, 188, 202, 1);
    --scroll-active-bg: rgba(236, 242, 248, 1);

    --button-text: rgba(236, 242, 248, 1);
    --button-selected-text: rgba(255, 255, 255, 1);
    --button-hover-text: rgba(255, 255, 255, 1);
    --input-text-color: rgba(255, 255, 255, 1);
    --text-message: rgba(236, 242, 248, 1);
    --text-warning: rgba(255, 198, 72, 1);
    --text-input-echo: rgba(204, 255, 224, 1);
    --text-shell: rgba(176, 188, 202, 1);
    --text-error: rgba(255, 148, 164, 1);

    --scroll-color: rgba(176, 188, 202, 1);
    --caret-color: rgba(98, 242, 160, 1);
}
