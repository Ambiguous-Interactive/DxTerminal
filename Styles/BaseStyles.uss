@import url("LegacyColors.uss");

.transparent-cursor {
    --unity-cursor-color: transparent;
}

.terminal-root {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.terminal-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.terminal-toolbar {
    flex-shrink: 0;
}

.terminal-header,
.terminal-search,
.terminal-severities {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    min-width: 0;
    padding: 2px 4px;
    background-color: var(--dxt-surface);
    color: var(--dxt-ink-muted);
}

.terminal-header-title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    margin: 0 4px;
}

.terminal-header .terminal-button,
.terminal-search .terminal-button,
.terminal-severities .terminal-button {
    flex-shrink: 0;
    min-height: 24px;
    background-color: var(--dxt-surface-raised);
    color: var(--dxt-ink-body);
}

.terminal-header .terminal-button:hover,
.terminal-search .terminal-button:hover,
.terminal-severities .terminal-button:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.terminal-search-field {
    flex-basis: 140px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 24px;
    margin: 0 2px;
    padding: 0;
}

.terminal-search-field > .unity-base-field__label {
    min-width: 0;
    width: 72px;
    flex-shrink: 0;
    margin: 0 4px 0 0;
}

.terminal-search-field > #unity-text-input {
    --unity-cursor-color: var(--dxt-accent);
    min-width: 0;
    background-color: var(--dxt-input);
    color: var(--dxt-ink);
    border-width: 0;
    padding: 2px 4px;
    margin: 0;
}

.terminal-search-field > #unity-text-input > .unity-text-element {
    color: var(--dxt-ink);
}

.terminal-search-count {
    flex-shrink: 0;
    white-space: normal;
    margin: 0 4px;
}

/* Text size presets (M 15, L 18; S 13 is the base default) precede narrow rules so touch targets keep 44 px floors. */
.terminal-text-size--medium .terminal-output-label,
.terminal-text-size--medium .terminal-output-label #unity-text-input,
.terminal-text-size--medium .terminal-output-label #unity-text-input .unity-text-element,
.terminal-text-size--medium .terminal-log-highlight,
.terminal-text-size--medium .terminal-input-caret,
.terminal-text-size--medium .terminal-input-field,
.terminal-text-size--medium .terminal-input-field > #unity-text-input,
.terminal-text-size--medium .terminal-input-field > #unity-text-input > .unity-text-element,
.terminal-text-size--medium .completion-name,
.terminal-text-size--medium .palette-row-name,
.terminal-text-size--medium .palette-output,
.terminal-text-size--medium .palette-feedback {
    font-size: 15px;
}

.terminal-text-size--medium .terminal-output-label {
    min-height: 26px;
}

.terminal-text-size--medium .terminal-output-label > .unity-base-field__label,
.terminal-text-size--medium .completion-detail-title,
.terminal-text-size--medium .completion-signature-description,
.terminal-text-size--medium .completion-description,
.terminal-text-size--medium .completion-hint,
.terminal-text-size--medium .completion-kind,
.terminal-text-size--medium .completion-keys,
.terminal-text-size--medium .terminal-validation-hint,
.terminal-text-size--medium .terminal-help-select-button {
    font-size: 13px;
}

.terminal-text-size--medium .completion-signature,
.terminal-text-size--medium .completion-detail-description,
.terminal-text-size--medium .terminal-validation-message,
.terminal-text-size--medium .terminal-help-signature,
.terminal-text-size--medium .terminal-help-description,
.terminal-text-size--medium .terminal-validation-chip,
.terminal-text-size--medium .terminal-help-example,
.terminal-text-size--medium .terminal-help-arg-name,
.terminal-text-size--medium .terminal-help-arg-type,
.terminal-text-size--medium .terminal-help-arg-default,
.terminal-text-size--medium .palette-row-help {
    font-size: 14px;
}

.terminal-text-size--medium .terminal-validation-chip,
.terminal-text-size--medium .terminal-input-caret,
.terminal-text-size--medium .terminal-input-field {
    height: 26px;
}

.terminal-text-size--medium .palette-input > #unity-text-input {
    font-size: 16px;
}

.terminal-text-size--medium .palette-footer {
    font-size: 12px;
}

.terminal-text-size--medium .completion-row {
    height: 28px;
}

.terminal-text-size--medium .input-container {
    height: 34px;
}

.terminal-text-size--large .terminal-output-label,
.terminal-text-size--large .terminal-output-label #unity-text-input,
.terminal-text-size--large .terminal-output-label #unity-text-input .unity-text-element,
.terminal-text-size--large .terminal-log-highlight,
.terminal-text-size--large .terminal-input-caret,
.terminal-text-size--large .terminal-input-field,
.terminal-text-size--large .terminal-input-field > #unity-text-input,
.terminal-text-size--large .terminal-input-field > #unity-text-input > .unity-text-element,
.terminal-text-size--large .completion-name,
.terminal-text-size--large .palette-row-name,
.terminal-text-size--large .palette-output,
.terminal-text-size--large .palette-feedback {
    font-size: 18px;
}

.terminal-text-size--large .terminal-output-label {
    min-height: 32px;
}

.terminal-text-size--large .terminal-output-label > .unity-base-field__label,
.terminal-text-size--large .completion-detail-title,
.terminal-text-size--large .completion-signature-description,
.terminal-text-size--large .completion-description,
.terminal-text-size--large .completion-hint,
.terminal-text-size--large .completion-kind,
.terminal-text-size--large .completion-keys,
.terminal-text-size--large .terminal-validation-hint,
.terminal-text-size--large .terminal-help-select-button {
    font-size: 15px;
}

.terminal-text-size--large .completion-signature,
.terminal-text-size--large .completion-detail-description,
.terminal-text-size--large .terminal-validation-message,
.terminal-text-size--large .terminal-help-signature,
.terminal-text-size--large .terminal-help-description {
    font-size: 16.5px;
}

.terminal-text-size--large .terminal-validation-chip,
.terminal-text-size--large .terminal-help-example,
.terminal-text-size--large .terminal-help-arg-name,
.terminal-text-size--large .terminal-help-arg-type,
.terminal-text-size--large .terminal-help-arg-default,
.terminal-text-size--large .palette-row-help {
    font-size: 16px;
}

.terminal-text-size--large .terminal-validation-chip {
    height: 30px;
}

.terminal-text-size--large .palette-input > #unity-text-input {
    font-size: 19px;
}

.terminal-text-size--large .palette-footer {
    font-size: 14px;
}

.terminal-text-size--large .completion-row {
    height: 34px;
}

.terminal-text-size--large .input-container {
    height: 40px;
}

.terminal-text-size--large .terminal-input-caret,
.terminal-text-size--large .terminal-input-field {
    height: 32px;
}

.terminal-root--narrow .terminal-header .terminal-button,
.terminal-root--narrow .terminal-search .terminal-button,
.terminal-root--narrow .terminal-severities .terminal-button,
.terminal-root--narrow .input-container .terminal-button,
.terminal-root--narrow .state-button-container .terminal-button {
    min-width: 44px;
    min-height: 44px;
    margin: 0 2px;
}

.terminal-root--narrow .terminal-header,
.terminal-root--narrow .terminal-search,
.terminal-root--narrow .terminal-severities {
    padding: 0 2px;
}

.terminal-root--narrow .terminal-search-field {
    flex-basis: 100%;
    flex-shrink: 0;
    width: 100%;
    min-height: 44px;
    margin: 0;
}

.terminal-root--narrow .terminal-search-field > #unity-text-input {
    min-height: 44px;
}

.completion-body {
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    flex-shrink: 1;
    min-height: 0;
    padding: 0 6px;
}

.completion-suggestions {
    align-self: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.completion-details {
    background-color: var(--dxt-surface-raised);
    border-radius: 4px;
    padding: 3px 5px;
}

.completion-detail-title,
.completion-detail-description,
.completion-signature-part,
.completion-signature-description {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.completion-signature,
.completion-signature-argument {
    flex-direction: row;
    align-items: center;
}

.completion-detail-title,
.completion-signature-description {
    color: var(--dxt-ink-muted);
    font-size: 11px;
}

.completion-signature-description {
    flex-grow: 1;
    flex-shrink: 1;
    -unity-text-align: middle-right;
}

.completion-details {
    width: 48%;
    align-self: flex-end;
    margin-left: 6px;
}

.completion-signature {
    padding: 0 6px;
    overflow: hidden;
    flex-shrink: 0;
    font-size: 12.5px;
}

.completion-detail-description {
    color: var(--dxt-ink-body);
}

.completion-signature-name,
.completion-signature-part {
    color: var(--dxt-ink);
}

.completion-signature-name {
    -unity-font-style: bold;
    margin-right: 5px;
}

.completion-signature-argument {
    margin-right: 3px;
    border-width: 1px;
    border-color: transparent;
    border-radius: 3px;
}

.completion-signature-part {
    margin: 0;
    padding: 0;
}

.completion-argument-active {
    background-color: var(--dxt-selection);
    border-color: var(--dxt-selection-line);
}

.completion-type-Number {
    color: var(--dxt-syn-number);
}

.completion-type-String {
    color: var(--dxt-syn-string);
}

.completion-type-Choice {
    color: var(--dxt-syn-choice);
}

.terminal-root--narrow .input-container {
    flex-wrap: wrap;
    height: auto;
    min-height: 44px;
}

.terminal-root--narrow .terminal-input-field {
    min-width: 44px;
    min-height: 44px;
}

.terminal-root--narrow .terminal-input-field > #unity-text-input {
    min-height: 44px;
}

.terminal-root--narrow .terminal-input-caret {
    min-height: 44px;
}

.terminal-root--narrow .terminal-output-label {
    min-height: 30px;
}

.terminal-root--narrow.terminal-text-size--large .terminal-output-label {
    min-height: 32px;
}

.terminal-root--narrow .log-scroll-view .unity-scroller--vertical,
.terminal-root--narrow .log-scroll-view .unity-scroller--vertical .unity-base-slider--vertical,
.terminal-root--narrow .log-scroll-view .unity-scroller .unity-base-slider__dragger {
    width: 44px;
    min-width: 44px;
}

.terminal-root--narrow .log-scroll-view .unity-scroller .unity-base-slider__dragger {
    min-height: 44px;
}

.log-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
}

.log-scroll-view .unity-scroller--vertical {
    width: 12px;
    min-width: 0;
}

.log-scroll-view .unity-scroller--vertical .unity-base-slider--vertical {
    border-color: transparent;
    width: 10px;
    min-width: 0;
    border-top-width: 5px;
    border-bottom-width: 5px;
}

.log-scroll-view .unity-base-slider {
    margin: 0;
}

.log-scroll-view .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 4px;
}

.log-scroll-view .unity-scroller .unity-base-slider__dragger {
    border-radius: 4px;
    border-width: 0;
    min-width: 0;
    width: 10px;
    left: 0;
}

.log-scroll-view .unity-scroller .unity-scroller__low-button,
.log-scroll-view .unity-scroller .unity-scroller__high-button {
    display: none;
    border-width: 0;
}

.log-scroll-view .unity-scroller .unity-base-slider__tracker {
    background-color: transparent;
    transition: background-color 0.1s ease;
}

.log-scroll-view .unity-scroller .unity-base-slider__tracker.dragger-hovered,
.log-scroll-view .unity-scroller .unity-base-slider__tracker.dragger-active {
    background-color: transparent;
}

.completion-panel,
.autocomplete-popup {
    flex-shrink: 1;
    min-height: 0;
}

.autocomplete-popup {
    background-color: var(--dxt-surface-raised);
}

.completion-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.completion-row > .unity-label {
    height: 100%;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.completion-name,
.completion-description,
.completion-hint {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.completion-name {
    width: 36%;
    flex-shrink: 0;
    -unity-font-style: bold;
}

.completion-description {
    flex-grow: 1;
    min-width: 0;
}

.completion-row > .completion-hint {
    flex-shrink: 0;
    max-width: 32%;
    -unity-text-align: middle-right;
}

.completion-description,
.completion-hint,
.completion-kind,
.completion-keys {
    color: var(--dxt-ink-muted);
    font-size: 11px;
}

.input-container {
    flex-direction: row;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    height: 30px;
    align-items: center;
}

.terminal-validation {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 28px;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: var(--dxt-line);
    background-color: var(--dxt-surface);
}

.terminal-validation--error {
    border-top-color: var(--dxt-error-line);
}

.terminal-validation-glyph,
.terminal-validation-message,
.terminal-validation-hint {
    margin: 0;
    padding: 0;
}

.terminal-validation-glyph {
    flex-shrink: 0;
    margin-right: 6px;
}

.terminal-validation-glyph--error {
    color: var(--dxt-error);
}

.terminal-validation-glyph--note {
    color: var(--dxt-ink-muted);
}

.terminal-validation-message {
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    color: var(--dxt-ink-body);
    font-size: 12.5px;
}

.terminal-validation-chip {
    flex-shrink: 0;
    height: 22px;
    margin: 0 6px;
    padding: 0 8px;
    border-width: 1px;
    border-color: var(--dxt-selection-line);
    border-radius: 6px;
    background-color: var(--dxt-selection);
    color: var(--dxt-ink);
    -unity-font-style: bold;
    font-size: 12px;
}

.terminal-validation-chip:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.terminal-validation-spacer {
    flex-grow: 1;
    flex-shrink: 1;
}

.terminal-validation-hint {
    flex-shrink: 0;
    margin-left: 8px;
    color: var(--dxt-ink-muted);
    font-size: 11px;
}

.state-button-container {
    position: absolute;
    flex-direction: row;
    left: 2px;
}

.terminal-output-label {
    flex-shrink: 0;
    min-width: 0;
    min-height: 22px;
    font-size: 13px;
    white-space: normal;
    margin: 0;
    padding: 0;
    border-left-width: 3px;
    border-left-color: transparent;
}

.terminal-output-label--current-match {
    border-left-color: var(--dxt-accent);
}

.terminal-output-label > .unity-base-field__label {
    width: auto;
    min-width: 90px;
    flex-shrink: 0;
    align-self: flex-start;
    white-space: nowrap;
    font-size: 11px;
    padding: 0;
    margin: 0 6px 0 0;
}

.terminal-output-label #unity-text-input {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    --unity-cursor-color: transparent;
    background-color: transparent;
    margin: 0;
    border-width: 0;
    padding: 0;
}

.terminal-log-highlight {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    white-space: normal;
    -unity-text-align: upper-left;
    margin: 0;
    padding: 0;
}

.terminal-help-card {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: column;
    margin: 4px 8px 4px 0;
    padding: 8px 12px;
    border-width: 1px;
    border-color: var(--dxt-line);
    border-radius: 8px;
    background-color: var(--dxt-surface-raised);
}

.terminal-help-card--plain-text {
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    margin: 0 8px 0 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.terminal-help-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.terminal-help-signature,
.terminal-help-description,
.terminal-help-example {
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 12.5px;
    color: var(--dxt-ink-body);
}

.terminal-help-signature {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-bottom: 0;
    color: var(--dxt-ink);
}

.terminal-help-select-button {
    flex-shrink: 0;
    margin: 0 0 0 8px;
    padding: 1px 6px;
    font-size: 11px;
    border-width: 1px;
    border-color: var(--dxt-line);
    background-color: var(--dxt-surface);
    color: var(--dxt-ink-muted);
}

.terminal-help-select-button:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.terminal-help-example {
    margin-bottom: 0;
    font-size: 12px;
}

.terminal-help-arguments {
    flex-direction: column;
    margin-bottom: 6px;
}

.terminal-help-arg-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
}

.terminal-help-arg-name,
.terminal-help-arg-type,
.terminal-help-arg-default {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    white-space: normal;
    margin: 0 8px 0 0;
    padding: 0;
    font-size: 12px;
}

.terminal-help-arg-name {
    color: var(--dxt-ink);
}

.terminal-help-arg-type.completion-type-Choice {
    -unity-font-style: bold;
}

.terminal-help-arg-default {
    margin-right: 0;
    color: var(--dxt-ink-muted);
}

.terminal-copy-status {
    flex-shrink: 0;
    color: var(--dxt-warning);
    background-color: var(--dxt-surface);
    white-space: normal;
    padding: 2px 4px;
}

.terminal-button {
    margin: 4px 2px;
    padding: 0 4px;
    border-radius: 4px;
    border-width: 0;
}

.terminal-button-jump-latest {
    flex-shrink: 0;
    background-color: var(--dxt-surface-raised);
    color: var(--dxt-ink-body);
}

.terminal-button-jump-latest:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.terminal-input-caret {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    height: 22px;
    font-size: 13px;
    align-items: center;
    padding: 2px 0;
    margin: 0;
}

.terminal-input-field {
    background-color: transparent;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    height: 22px;
    font-size: 13px;
    flex-grow: 1;
    flex-shrink: 1;
    padding: 0;
    margin: 0;
}

.terminal-input-field > #unity-text-input {
    background-color: var(--dxt-input);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    padding: 2px 0;
    margin: 0;
}

/* -- Theming -- */

.styled-cursor {
    --unity-cursor-color: var(--dxt-accent);
}

.terminal-container,
.log-scroll-view .unity-scroller .unity-scroller__dragger {
    background-color: var(--dxt-surface);
}

.log-scroll-view .unity-scroller .unity-base-slider__dragger {
    background-color: var(--dxt-ink-muted);
    transition: background-color 0.1s ease;
}

.log-scroll-view .unity-scroller .unity-base-slider__dragger:hover,
.log-scroll-view .unity-scroller .unity-base-slider__tracker:hover,
.log-scroll-view .unity-scroller .unity-base-slider__dragger:active,
.log-scroll-view .unity-scroller .unity-base-slider__tracker:active,
.log-scroll-view .unity-scroller .unity-base-slider__dragger.dragger-active {
    background-color: var(--dxt-ink-body);
}

.log-scroll-view .unity-scroller .unity-base-slider__dragger.tracker-hovered,
.log-scroll-view .unity-scroller .unity-base-slider__dragger.tracker-active {
    background-color: var(--dxt-ink-muted);
}

.autocomplete-item {
    background-color: var(--dxt-surface-raised);
    transition: background-color 0.1s ease;
    color: var(--dxt-ink-body);
}

.autocomplete-item:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.autocomplete-item,
.autocomplete-item-selected {
    border-width: 1px;
    border-color: transparent;
    padding: 0 3px;
}

.autocomplete-item-selected {
    border-color: var(--dxt-selection-line);
    background-color: var(--dxt-selection);
    color: var(--dxt-ink);
}

.autocomplete-item-selected:hover {
    background-color: var(--dxt-hover);
    color: var(--dxt-ink);
}

.terminal-button-run {
    background-color: var(--dxt-surface-raised);
    color: var(--dxt-ink-body);
}

.terminal-input-caret {
    color: var(--dxt-accent);
    background-color: var(--dxt-input);
}

.terminal-input-field > #unity-text-input,
.terminal-input-field > #unity-text-input > .unity-text-element {
    color: var(--dxt-ink);
}

.state-button-container .terminal-button {
    background-color: var(--dxt-surface-raised);
    color: var(--dxt-ink-body);
}

.state-button-container .terminal-button:hover {
    background-color: var(--dxt-selection);
    color: var(--dxt-ink);
}

.terminal-output-label--message,
.terminal-output-label--message > .unity-base-field__label,
.terminal-output-label--message #unity-text-input,
.terminal-output-label--message #unity-text-input .unity-text-element {
    color: var(--dxt-ink-body);
}

.terminal-output-label--warning,
.terminal-output-label--warning > .unity-base-field__label,
.terminal-output-label--warning #unity-text-input,
.terminal-output-label--warning #unity-text-input .unity-text-element {
    color: var(--dxt-warning);
}

.terminal-output-label--input,
.terminal-output-label--input > .unity-base-field__label,
.terminal-output-label--input #unity-text-input,
.terminal-output-label--input #unity-text-input .unity-text-element {
    color: var(--dxt-accent-soft);
}

.terminal-output-label--shell,
.terminal-output-label--shell > .unity-base-field__label,
.terminal-output-label--shell #unity-text-input,
.terminal-output-label--shell #unity-text-input .unity-text-element {
    color: var(--dxt-ink-muted);
}

.terminal-output-label--error,
.terminal-output-label--error > .unity-base-field__label,
.terminal-output-label--error #unity-text-input,
.terminal-output-label--error #unity-text-input .unity-text-element {
    color: var(--dxt-error-text);
}


.terminal-severities .terminal-type-chip {
    background-color: var(--dxt-selection);
    color: var(--dxt-ink);
}

.terminal-severities .terminal-type-chip--excluded {
    background-color: var(--dxt-surface-raised);
    color: var(--dxt-ink-body);
    border-bottom-width: 2px;
    border-bottom-color: var(--dxt-ink-muted);
}

.terminal-root--narrow .terminal-type-chip {
    font-size: 12px;
}

/* -- Command palette -- */

.palette-panel {
    background-color: var(--dxt-surface);
    border-color: var(--dxt-line);
    border-width: 1px;
    border-radius: 12px;
    padding: 12px;
}

.palette-input-container {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 10px;
    background-color: var(--dxt-input);
    border-width: 1px;
    border-color: var(--dxt-line);
    border-radius: 8px;
}

.palette-prompt {
    flex-shrink: 0;
    margin: 0 6px 0 0;
    padding: 0;
    font-size: 15px;
    color: var(--dxt-accent);
    -unity-text-align: middle-left;
}

.palette-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
}

.palette-input > #unity-text-input,
.palette-input > #unity-text-input > .unity-text-element {
    color: var(--dxt-ink);
}

.palette-input > #unity-text-input {
    --unity-cursor-color: var(--dxt-accent);
    --unity-selection-color: var(--dxt-selection);
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    font-size: 15px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
}

.palette-panel .completion-signature {
    margin-top: 6px;
    border-radius: 6px;
}

.palette-panel .terminal-validation {
    margin-top: 6px;
    border-width: 1px;
    border-color: var(--dxt-line);
    border-radius: 8px;
    background-color: var(--dxt-surface-raised);
    padding: 6px 10px;
}

.palette-panel .terminal-validation--error {
    border-color: var(--dxt-error-line);
}

.palette-divider {
    height: 1px;
    margin-top: 8px;
    align-self: stretch;
    background-color: var(--dxt-line);
}

.palette-recent-header {
    margin: 6px 4px 2px 4px;
    padding: 0;
    font-size: 11px;
    color: var(--dxt-ink-muted);
    -unity-text-align: middle-left;
}

.palette-results {
    margin-top: 4px;
    background-color: transparent;
}

.palette-results .unity-scroller--vertical {
    width: 10px;
    min-width: 0;
}

.palette-results .unity-scroller--vertical .unity-base-slider--vertical {
    border-color: transparent;
    width: 10px;
    min-width: 0;
    border-top-width: 4px;
    border-bottom-width: 4px;
}

.palette-results .unity-scroller .unity-base-slider {
    margin: 0;
}

.palette-results .unity-scroller .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 4px;
    background-color: transparent;
    transition: background-color 0.1s ease;
}

.palette-results .unity-scroller .unity-base-slider__dragger {
    border-radius: 4px;
    border-width: 0;
    min-width: 0;
    width: 10px;
    left: 0;
    background-color: var(--dxt-ink-muted);
    transition: background-color 0.1s ease;
}

.palette-results .unity-scroller .unity-base-slider__dragger:hover,
.palette-results .unity-scroller .unity-base-slider__tracker:hover,
.palette-results .unity-scroller .unity-base-slider__dragger:active,
.palette-results .unity-scroller .unity-base-slider__tracker:active {
    background-color: var(--dxt-ink-body);
}

.palette-results .unity-scroller .unity-scroller__low-button,
.palette-results .unity-scroller .unity-scroller__high-button {
    display: none;
    border-width: 0;
}

.palette-row {
    flex-direction: row;
    align-items: center;
    padding: 0 10px;
    border-width: 1px;
    border-color: transparent;
    border-radius: 8px;
    transition: background-color 0.1s ease;
}

.palette-row:hover {
    background-color: var(--dxt-hover);
}

.palette-row-selected,
.palette-row-selected:hover {
    background-color: var(--dxt-selection);
    border-color: var(--dxt-selection-line);
}

.palette-row-name {
    flex-shrink: 0;
    min-width: 140px;
    max-width: 42%;
    margin: 0;
    padding: 0;
    font-size: 14px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    color: var(--dxt-ink-body);
}

.palette-row:hover .palette-row-name {
    color: var(--dxt-ink);
}

.palette-row-selected .palette-row-name {
    color: var(--dxt-ink);
}

.palette-row-help {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 13px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
    color: var(--dxt-ink-muted);
}

.palette-row-hint {
    flex-shrink: 0;
    margin: 0 0 0 8px;
    padding: 0;
    font-size: 11px;
    color: var(--dxt-ink-muted);
    -unity-text-align: middle-right;
}

.palette-output,
.palette-feedback {
    margin-top: 8px;
    padding: 8px 10px;
    white-space: normal;
    background-color: var(--dxt-surface-raised);
    border-width: 1px;
    border-color: var(--dxt-line);
    border-radius: 8px;
}

.palette-output {
    color: var(--dxt-ink-body);
}

.palette-feedback {
    color: var(--dxt-error-text);
}

.palette-feedback--error {
    border-color: var(--dxt-error-line);
}

.palette-footer {
    min-height: 24px;
    margin: 6px 0 0 0;
    padding: 0 2px;
    font-size: 11px;
    -unity-text-align: middle-left;
    color: var(--dxt-ink-muted);
}

.palette-root--narrow .palette-panel {
    width: 100%;
    border-radius: 0;
    padding: 10px;
}

.terminal-header .terminal-button:focus,
.terminal-search .terminal-button:focus,
.terminal-severities .terminal-button:focus,
.input-container .terminal-button:focus {
    background-color: var(--dxt-selection);
    color: var(--dxt-ink);
}

.terminal-motion--snappy .log-scroll-view .unity-scroller .unity-base-slider__tracker,
.terminal-motion--snappy .log-scroll-view .unity-scroller .unity-base-slider__dragger,
.terminal-motion--snappy .autocomplete-item,
.terminal-motion--snappy .palette-results .unity-scroller .unity-base-slider__tracker,
.terminal-motion--snappy .palette-results .unity-scroller .unity-base-slider__dragger,
.terminal-motion--snappy .palette-row {
    transition-duration: 0.05s;
}

.terminal-motion--none .log-scroll-view .unity-scroller .unity-base-slider__tracker,
.terminal-motion--none .log-scroll-view .unity-scroller .unity-base-slider__dragger,
.terminal-motion--none .autocomplete-item,
.terminal-motion--none .palette-results .unity-scroller .unity-base-slider__tracker,
.terminal-motion--none .palette-results .unity-scroller .unity-base-slider__dragger,
.terminal-motion--none .palette-row {
    transition-duration: 0s;
}
